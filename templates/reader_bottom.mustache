<!-- bottom overlay: page list only. Shown only while navShown. -->
<div x-show="navShown && !done" x-cloak
     class="fixed bottom-0 inset-x-0 z-30 bg-zinc-950/90 border-t border-zinc-800 backdrop-blur">
  <template x-if="pages.length <= 24">
    <div class="flex gap-1 flex-wrap justify-center px-2 py-2">
      <template x-for="n in pages.length" :key="n">
        <button @click="goto_page(n)"
                :class="n === page ? 'bg-zinc-100 text-zinc-900 border-zinc-100' : 'text-zinc-300 border-zinc-700 hover:bg-zinc-800'"
                class="w-10 h-10 text-base leading-none font-medium tabular-nums rounded border"
                x-text="n"></button>
      </template>
    </div>
  </template>
  <template x-if="pages.length > 24">
    <div class="flex justify-center px-2 py-2">
      <select :value="page" @change="goto_page(Number($event.target.value))" aria-label="Page"
              class="bg-zinc-900 border border-zinc-700 rounded px-3 py-2 text-sm">
        <template x-for="n in pages.length" :key="n">
          <option :value="n" :selected="n === page" x-text="'p ' + n + ' / ' + pages.length"></option>
        </template>
      </select>
    </div>
  </template>
</div>
