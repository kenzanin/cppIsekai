{{>top.mustache}}
  <div class="flex gap-6">
    <aside class="w-52 shrink-0 space-y-4">
      <nav class="space-y-1">
        <a href="/" class="block px-2 py-1 rounded {{^filtered}}bg-zinc-800{{/filtered}}"
           hx-get="/library/grid" hx-target="#grid" hx-push-url="/">All plugins</a>
        {{#plugins}}
        <a href="/?plugin={{name}}"
           class="flex justify-between px-2 py-1 rounded {{#current}}bg-zinc-800{{/current}}"
           hx-get="/library/grid?plugin={{name}}" hx-target="#grid" hx-push-url="/?plugin={{name}}">
          <span class="flex items-center gap-1.5">
            {{#logo}}<img src="/plugin/{{logo}}/logo" alt="" class="w-4 h-4 rounded-sm">{{/logo}}
            <span>{{name}}</span>
          </span>
          <span class="text-zinc-500">{{titles}}</span>
        </a>
        {{/plugins}}
      </nav>
      <p class="px-2 text-sm text-zinc-400">{{total}} titles</p>
      <p class="px-2 text-sm text-zinc-600">more later</p>
    </aside>
    <section class="flex-1 space-y-4">
      <form action="/" method="get" class="flex gap-2"
            hx-get="/library/grid" hx-target="#grid" hx-push-url="true">
        {{#filtered}}<input type="hidden" name="plugin" value="{{plugin}}">{{/filtered}}
        <input name="q" value="{{q}}" placeholder="Search library"
               class="flex-1 bg-zinc-900 border border-zinc-700 rounded px-3 py-1.5">
      </form>
      <div id="grid">
        {{>grid_body.mustache}}
      </div>
    </section>
  </div>
{{>bottom.mustache}}
