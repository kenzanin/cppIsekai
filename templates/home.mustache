{{>top.mustache}}
  <div class="flex gap-6">
    <aside class="w-52 shrink-0 space-y-4">
      {{#saved_mode}}
      <button onclick="window.dispatchEvent(new CustomEvent('grid:reset'))"
              class="block w-full text-left px-3 py-2 rounded border border-zinc-700 bg-zinc-900 hover:bg-zinc-800">
        <span class="block text-lg font-semibold text-zinc-100">{{saved_total_all}}</span>
        <span class="block text-xs text-zinc-500">titles · reset filters</span>
      </button>
      <button onclick="window.dispatchEvent(new CustomEvent('grid:toggle-dup'))"
              class="block w-full text-left px-3 py-2 rounded border border-zinc-700 bg-zinc-900 hover:bg-zinc-800">
        <span class="block text-lg font-semibold text-zinc-100">{{dup_total}}</span>
        <span class="block text-xs text-zinc-500">duplicates · filter clusters</span>
      </button>
      {{/saved_mode}}
      <nav class="space-y-1">
        <a href="/" data-grid-plugin="" class="block px-2 py-1 rounded {{^filtered}}bg-zinc-800{{/filtered}}"
           onclick="{{#saved_mode}}event.preventDefault();window.dispatchEvent(new CustomEvent('grid:plugin',{detail:''})){{/saved_mode}}"
           {{^saved_mode}}hx-get="/library/grid" hx-target="#grid" hx-push-url="/"{{/saved_mode}}>All plugins</a>
        {{#plugins}}
        <a href="/?plugin={{id}}"
           data-grid-plugin="{{id}}"
           class="flex justify-between px-2 py-1 rounded {{#current}}bg-zinc-800{{/current}}"
           onclick="{{#saved_mode}}event.preventDefault();window.dispatchEvent(new CustomEvent('grid:plugin',{detail:'{{id}}'})){{/saved_mode}}"
           {{^saved_mode}}hx-get="/library/grid?plugin={{id}}" hx-target="#grid" hx-push-url="/?plugin={{id}}"{{/saved_mode}}>
          <span class="flex items-center gap-1.5">
            {{#logo}}<img src="/plugin/{{logo}}/logo" alt="" class="w-4 h-4 rounded-sm">{{/logo}}
            <span>{{name}}</span>
          </span>
          <span class="text-zinc-500">{{titles}}</span>
        </a>
        {{/plugins}}
      </nav>

    </aside>
    <section class="flex-1 space-y-4">
      <form action="/" method="get" class="flex gap-2"
            hx-get="/library/grid" hx-target="#grid" hx-push-url="true">
        {{#filtered}}<input type="hidden" name="plugin" value="{{plugin}}">{{/filtered}}
        <input name="q" value="{{q}}" placeholder="Search library"
               class="focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:border-transparent transition flex-1 bg-zinc-900 border border-zinc-700 rounded px-3 py-1.5">
      </form>
      <div id="grid">
        {{>grid_body.mustache}}
      </div>
    </section>
  </div>
{{>bottom.mustache}}
