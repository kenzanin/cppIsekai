<script>
function detailPage() {
  const parts = location.pathname.split('/').filter(Boolean); // view manga <plugin> <slug...>
  return {
    plugin: parts[2] || '', slug: parts.slice(3).join('/') || '',
    detail: {}, chapters: [], cached: false, loading: true, refreshing: false,
    err: '', coverBroken: false, hint: null, related: [], pluginName: '', pluginLogoOk: true,
    inLibrary: false, libraryBusy: false,
    chPage: 0, showHidden: false, readState: {}, // id -> {skip, read} (chapter-list-controls 1.2)
    get pageCount() { return Math.max(1, Math.ceil(this.visibleChapters().length / 20)); },
    visibleChapters() { return this.showHidden ? this.chapters : this.chapters.filter(c => !c.done); },
    chPageRows() { return this.visibleChapters().slice(this.chPage * 20, this.chPage * 20 + 20); },
    hiddenCount() { return this.chapters.length - this.visibleChapters().length; },
    readMax(ch) { return (this.readState[ch.id] && this.readState[ch.id].read) || 0; },
    isRead(ch) { return ch.pages ? this.readMax(ch) >= ch.pages : this.readMax(ch) > 0; },
    async loadChapterState() {
      if (!this.chapters.length) return;
      try {
        const r = await fetch('/chapter/state', {method: 'POST', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ids: this.chapters.map(c => c.id)})});
        if (r.ok) { const j = await r.json(); this.chapters.forEach(c => { if (j[c.id]) c.done = !!j[c.id].skip; }); this.readState = j; }
      } catch (e) { /* list renders without state */ }
    },
    async toggleRead(ch) {
      const to = this.isRead(ch) ? 0 : (ch.pages || 1);
      this.readState[ch.id] = {...(this.readState[ch.id] || {}), read: to || undefined};
      if (!to) delete this.readState[ch.id].read;
      try { await fetch(`/chapter/${encodeURIComponent(ch.id)}/read`, {method: 'POST',
        headers: {'Content-Type': 'application/json'}, body: JSON.stringify({page: to})}); } catch (e) {}
    },
    async toggleDone(ch) {
      ch.done = !ch.done;
      try { await fetch(`/chapter/${encodeURIComponent(ch.id)}/skip`, {method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({skipped: ch.done})}); } catch (e) {}
    },
    async boot() {
      this.loadPluginMeta();
      this.loadLibrary();
      await this.load();
      this.loadChapterState();
    },
    async load() {
      this.loading = true; this.err = '';
      this.loadRelated(); // fire-and-forget (D4): failure never blocks the page
      try {
        // continue-hint badge (reader-page 2.2): stored position, if any.
        if (this.plugin && this.slug) {
          const r = await fetch(`/api/position/${encodeURIComponent(this.plugin)}/${encodeURIComponent(this.slug)}`);
          if (r.ok) {
            const p = await r.json();
            if (p && p.ch) {
              this.hint = {
                text: `continue ch ${p.ch} p ${p.page || 1}`,
                url: `/read/${encodeURIComponent(this.plugin)}/${encodeURIComponent(this.slug)}?ch=${p.ch}`
              };
            }
          }
        }
        const d = await (await fetch(`/api/detail/${this.plugin}/${encodeURIComponent(this.slug)}`)).json();
        const c = await (await fetch(`/api/chapters/${this.plugin}/${encodeURIComponent(this.slug)}`)).json();
        if (!d.ok || !c.ok) { this.err = d.error || c.error || 'load failed'; return; }
        this.detail = d.data || {}; this.cached = !!(d.cached || c.cached);
        this.chapters = (c.data || []).slice().sort((a, b) => (b.number ?? 0) - (a.number ?? 0));
      } catch (e) { this.err = String(e); }
      this.loading = false;
    },
    async refresh() {
      this.refreshing = true;
      try {
        const r = await (await fetch(`/api/refresh/${this.plugin}/${encodeURIComponent(this.slug)}`, {method: 'POST'})).json();
        if (!r.ok) { this.err = r.error || 'refresh failed'; } else { await this.load(); this.cached = false; }
      } catch (e) { this.err = String(e); }
      this.refreshing = false;
    },
    chLabel(ch) { const n = Number(ch.number); return Number.isFinite(n) ? 'ch ' + String(n).padStart(3, '0') : (ch.title || 'ch'); },
    chSlug(ch) { const n = Number(ch.number); return Number.isFinite(n) && n > 0 ? 'ch' + String(n).padStart(3, '0') : 'chx'; },
    fmtDate(ts) { if (!ts) return ''; const d = new Date(ts * 1000); return isNaN(d) ? '' : d.toISOString().slice(0, 10); },
    async loadRelated() {
      try {
        const r = await fetch(`/api/related/${encodeURIComponent(this.plugin)}/${encodeURIComponent(this.slug)}`);
        if (r.ok) {
          const j = await r.json();
          if (j.ok) this.related = (j.data && j.data.items) || [];
        }
      } catch (e) { /* related section stays hidden */ }
    },
    async toggleLibrary() {
      if (this.libraryBusy) return;
      this.libraryBusy = true;
      try {
        const url = this.inLibrary ? '/api/library/remove' : '/api/library';
        const body = {plugin: this.plugin, slug: this.slug, name: (this.detail && this.detail.name) || this.slug,
                      cover: (this.detail && this.detail.cover) || ''};
        const r = await fetch(url, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)});
        const j = await r.json().catch(() => null);
        if (!r.ok || !j || j.ok === false) { this.err = (j && j.error) || 'library failed'; }
        else this.inLibrary = !this.inLibrary;
      } catch (e) { this.err = String(e); }
      this.libraryBusy = false;
    },
    async loadLibrary() {
      try {
        const r = await fetch('/api/library');
        if (r.ok) {
          const j = await r.json();
          if (j.ok) this.inLibrary = (j.data || []).some(m => m.plugin === this.plugin && m.slug === this.slug);
        }
      } catch (e) { /* toggle stays at default false; err line untouched */ }
    },
    async loadPluginMeta() {
      try {
        const r = await fetch('/api/plugins');
        const j = r.ok ? await r.json() : {};
        const m = (j.plugins || []).find(p => p.key === this.plugin);
        this.pluginName = (m && m.name) || this.plugin;
      } catch (e) { this.pluginName = this.plugin; }
    },
  };
}
</script>
