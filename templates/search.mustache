{{>top.mustache}}
<div x-data="searchPage" x-init="boot()">
  <!-- plugin + query row -->
  <div class="flex items-center gap-3 mb-4">
    <select x-model="plugin" @change="pick()" class="bg-zinc-900 border border-zinc-700 rounded px-2 py-1.5 text-sm">
      <option value="" disabled>select a plugin</option>
      <template x-for="p in plugins" :key="p.key">
        <option :value="p.key" x-text="p.name"></option>
      </template>
    </select>
    <template x-if="plugin && !logoBroken">
      <span class="w-6 h-6 rounded bg-zinc-800 flex items-center justify-center text-xs font-bold">
        <img :src="'/plugin/'+plugin+'/logo'" class="w-6 h-6 rounded object-cover" @error="logoBroken=true" alt="">
      </span>
    </template>
    <input x-model="q" @keydown.enter="search()"
           placeholder="Search manga…" class="focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:border-transparent transition flex-1 bg-zinc-900 border border-zinc-700 rounded px-3 py-1.5">
    <button @click="search()" :disabled="!plugin || loading"
            class="px-4 py-1.5 text-sm bg-zinc-800 rounded hover:bg-zinc-700 disabled:opacity-40">Search</button>
  </div>
  <p class="text-xs text-yellow-500 mb-3" x-show="notice" x-text="notice" x-cloak></p>

  <!-- genre chips -->
  <div class="flex flex-wrap gap-1.5 mb-3" x-show="genres.length" x-cloak>
    <template x-for="g in genres" :key="g">
      <button @click="toggleTag(g)"
              class="text-xs px-2 py-0.5 rounded-full border"
              :class="tags.includes(g) ? 'bg-zinc-100 text-zinc-900 border-zinc-100' : 'bg-zinc-900 border-zinc-700 text-zinc-400'"
              x-text="g"></button>
    </template>
  </div>

  <!-- count -->
  <div class="mb-2 text-sm text-zinc-400"><span x-text="total===null ? '' : total+' results'"></span></div>
  <!-- top pager (same markup/location/font as bottom pager) -->
  <div class="flex justify-end mb-3" x-show="pages()>1" x-cloak>
    <nav class="flex gap-1 items-center text-sm text-zinc-400">
      <button @click="go(page-1)" :disabled="page<=1" class="px-2 py-1 rounded bg-zinc-800 hover:bg-zinc-700 disabled:opacity-30">‹</button>
      <template x-for="n in window()" :key="'t'+$index+':'+n">
        <span x-show="n===0" class="px-1 text-zinc-600">…</span>
        <button x-show="n!==0" @click="go(n)" class="px-2 py-1 rounded" :class="n===page ? 'bg-zinc-700 text-zinc-100' : 'bg-zinc-800 hover:bg-zinc-700'" x-text="n"></button>
      </template>
      <button @click="go(page+1)" :disabled="page>=pages()" class="px-2 py-1 rounded bg-zinc-800 hover:bg-zinc-700 disabled:opacity-30">›</button>
    </nav>
  </div>

  <!-- error -->
  <div class="text-sm text-red-400 mb-2" x-show="err" x-cloak>
    <span x-text="err"></span>
    <button @click="run()" class="underline ml-2">Retry</button>
  </div>

  <!-- skeleton -->
  <div x-show="loading" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4" x-cloak>
    <template x-for="i in 12" :key="'sk'+i">
      <div>
        <div class="aspect-[3/4] rounded bg-zinc-800 animate-pulse"></div>
        <div class="h-3 mt-1 rounded bg-zinc-800 animate-pulse"></div>
      </div>
    </template>
  </div>

  <!-- grid -->
  <div x-show="!loading && items.length" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4" x-cloak>
    <template x-for="(it,idx) in items" :key="it.id">
      <li class="list-none">
        <a :href="'/view/manga/'+plugin+'/'+encodeURIComponent(it.id)" class="block group">
          <div class="aspect-[3/4] rounded overflow-hidden"
               :style="'background:hsl('+(idx*47%360)+' 40% 28%)'">
            <img :src="'/cache/img?url='+encodeURIComponent(it.cover)+'&cover=1&plugin='+encodeURIComponent(plugin)" class="w-full h-full object-cover" loading="lazy"
                 @error="$el.style.display='none'" alt="">
          </div>
          <p class="mt-1 text-sm truncate group-hover:text-white" x-text="it.name"></p>
          <p class="text-xs text-zinc-500" x-text="it.status"></p>
        </a>
      </li>
    </template>
  </div>

  <!-- empty -->
  <div x-show="!loading && total===0" class="text-zinc-500 text-sm py-8 text-center" x-cloak>
    No results for this search — try different keywords or fewer filters.
  </div>

  <!-- bottom pager -->
  <div class="flex justify-end mt-4 mb-8" x-show="pages()>1" x-cloak>
    <nav class="flex gap-1 items-center text-sm text-zinc-400">
      <button @click="go(page-1)" :disabled="page<=1" class="px-2 py-1 rounded bg-zinc-800 hover:bg-zinc-700 disabled:opacity-30">‹</button>
      <template x-for="n in window()" :key="'b'+$index+':'+n">
        <span x-show="n===0" class="px-1 text-zinc-600">…</span>
        <button x-show="n!==0" @click="go(n)" class="px-2 py-1 rounded" :class="n===page ? 'bg-zinc-700 text-zinc-100' : 'bg-zinc-800 hover:bg-zinc-700'" x-text="n"></button>
      </template>
      <button @click="go(page+1)" :disabled="page>=pages()" class="px-2 py-1 rounded bg-zinc-800 hover:bg-zinc-700 disabled:opacity-30">›</button>
    </nav>
  </div>
</div>
{{>search_script.mustache}}
{{>bottom.mustache}}
