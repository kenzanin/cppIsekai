{{#saved_mode}}
<div x-data="gridPage">
<script>
function gridPage() {
  let prefs = {};
  try { prefs = JSON.parse(localStorage.getItem('grid_prefs') || '{}'); } catch (_) { prefs = {}; }
  const V2 = prefs.v === 2; // v2: default sort is recent-read; older prefs fall back to defaults once
  return {
    q: prefs.q || '', plugin: V2 ? (prefs.plugin || '') : '', sort: V2 ? (prefs.sort || 'read') : 'read',
    sortDir: V2 ? (prefs.sortDir || {}) : { read: 'desc' }, dup: V2 && !!prefs.dup,
    filterState: Object.assign({ new: 'off', done: 'off', ongoing: 'off', hiatus: 'off', canceled: 'off', completed: 'off', orphan: 'off' }, prefs.filterState || {}),
    page: 1, perPage: 30,
    pages: 1, count: 0, total: 0, pins: 0, hasDup: false, hasStats: false,
    init() {
      if (this.dup) this.sort = 'dup'; // restored chip keeps cluster order
      this.rescan();
      this.updatePerPage();
      // shareable URL beats saved prefs (same state the reader puts in the address bar)
      this.fromUrl();
      const inp = document.getElementById('lib-q');
      if (inp) {
        if (this.q) inp.value = this.q;
        inp.addEventListener('input', () => { this.q = inp.value; this.page = 1; this.apply(); });
      }
      window.addEventListener('grid:reset', () => this.reset());
      window.addEventListener('grid:plugin', (e) => { this.plugin = e.detail || ''; this.page = 1; this.apply(); });
      window.addEventListener('grid:toggle-dup', () => this.toggleDup());
      window.addEventListener('resize', () => this.updatePerPage());
      document.body.addEventListener('htmx:afterSwap', () => { this.rescan(); this.apply(); });
      this.apply();
    },
    updatePerPage() { // 6 cols × 5 rows = 30; scales with responsive grid columns
      const cols = window.innerWidth >= 1024 ? 6 : window.innerWidth >= 768 ? 4 : 2;
      this.perPage = cols * 5;
    },
    syncSidebar() { document.querySelectorAll('[data-grid-plugin]').forEach(el => el.classList.toggle('bg-zinc-800', (el.dataset.gridPlugin || '') === this.plugin)); },
    rescan() {
      this.cards = typeof document !== 'undefined'
        ? Array.from(document.querySelectorAll('#pinned-cards > li, #saved-cards > li'))
        : [];
      this.total = this.cards.length;
      this.hasDup = this.cards.some(c => (+c.dataset.dup || 0) > 0);
      this.hasStats = this.cards.some(c => (+c.dataset.total || 0) > 0);
    },
    save() { try { localStorage.setItem('grid_prefs', JSON.stringify({ v: 2, q: this.q, plugin: this.plugin, sort: this.sort, sortDir: this.sortDir, dup: this.dup, filterState: this.filterState })); } catch (_) {} },
    fromUrl() { // shareable grid state: ?q&plugin&sort&dir&dup&f=new:show,done:hide&page
      const sp = new URLSearchParams(location.search);
      if (sp.has('q')) this.q = sp.get('q');
      const plug = sp.get('plugin'); if (plug) this.plugin = plug;
      const s = sp.get('sort');
      if (['added', 'title', 'progress', 'read', 'update', 'dup'].includes(s)) {
        this.sort = s; this.sortDir[s] = sp.get('dir') === 'desc' ? 'desc' : 'asc';
        if (s === 'dup') this.dup = true;
      }
      if (sp.get('dup') === '1') { this.dup = true; if (this.sort === 'read') this.sort = 'dup'; }
      const f = sp.get('f');
      if (f) for (const kv of f.split(',')) {
        const [k, v] = kv.split(':');
        if (k in this.filterState && (v === 'show' || v === 'hide')) this.filterState[k] = v;
      }
      const n = parseInt(sp.get('page'), 10);
      if (n > 1) this.page = n;
    },
    sync() { // replaceState like the reader: URL always shareable, no history spam
      const p = {};
      if (this.q) p.q = this.q;
      if (this.plugin) p.plugin = this.plugin;
      if (this.sort !== 'read' || (this.sortDir.read || 'desc') !== 'desc') { p.sort = this.sort; p.dir = this.sortDir[this.sort] || 'asc'; }
      if (this.dup) p.dup = '1';
      const f = Object.keys(this.filterState).filter(k => this.filterState[k] && this.filterState[k] !== 'off').map(k => k + ':' + this.filterState[k]);
      if (f.length) p.f = f.join(',');
      if (this.page > 1) p.page = this.page;
      const u = new URL(location); u.search = '';
      for (const [k, v] of Object.entries(p)) u.searchParams.set(k, v);
      history.replaceState({}, '', u);
    },
    toggleBadge(kind) { // 3-state per badge: off -> show -> hide -> off
      const st = this.filterState;
      const cur = st[kind] || 'off';
      st[kind] = cur === 'off' ? 'show' : cur === 'show' ? 'hide' : 'off';
      this.page = 1; this.apply();
    },
    toggleDup() { // chip re-engages cluster order (library-dedup 3.2; regressed in the prefs-v2 rewrite)
      this.dup = !this.dup;
      if (this.dup) { this.sort = 'dup'; }
      else if (this.sort === 'dup') { this.sort = 'read'; this.sortDir.read = 'desc'; }
      this.page = 1; this.apply();
    },
    setPlugin(p) { this.plugin = (this.plugin === p ? '' : p); this.page = 1; this.apply(); },
    setSort(s) { // 3-state per key: off -> asc -> desc -> off(default recent-read); the default key only toggles asc/desc
      const cur = this.sort === s ? (this.sortDir[s] || 'asc') : null;
      if (cur === null) { this.sort = s; this.sortDir[s] = 'asc'; }
      else if (cur === 'asc') { this.sortDir[s] = 'desc'; }
      else if (s === 'read') { this.sortDir.read = 'asc'; }
      else { this.sort = 'read'; this.sortDir.read = 'desc'; }
      this.page = 1; this.apply();
    },
    scls(k) { return this.sort === k ? 'text-zinc-50 bg-zinc-800 rounded' : 'text-zinc-500 hover:text-zinc-200'; },
    sarrow(k) { return this.sort === k ? ((this.sortDir[k] || 'asc') === 'desc' ? ' \u2193' : ' \u2191') : ''; },
    reset() { this.q = ''; const i = document.getElementById('lib-q'); if (i) i.value = '';
      this.plugin = ''; this.sort = 'read'; this.sortDir = { read: 'desc' }; this.dup = false;
      this.filterState = { new: 'off', done: 'off', ongoing: 'off', hiatus: 'off', canceled: 'off', completed: 'off', orphan: 'off' }; this.page = 1; this.apply(); },
    hasOrphan() { return this.cards.some(c => c.dataset.state === 'orphan'); },
    ratio(c) { const t = +c.dataset.total || 0; return t > 0 ? (+c.dataset.read || 0) / t : -1; },
    badge(c) { // New/Done from stored status_flags bits (bit0=is_new, bit1=is_done); Done priority kept by caller
      const f = +c.dataset.statusFlags || 0;
      return { news: !!(f & 1), done: !!(f & 2) };
    },
    haystack(c) { // name + alt titles + synopsis, memoized per node
      if (!c._hay) {
        let alt = '';
        try { const a = JSON.parse(c.dataset.alt || '[]'); alt = Array.isArray(a) ? a.join(' ') : String(c.dataset.alt || ''); }
        catch (_) { alt = c.dataset.alt || ''; }
        c._hay = ((c.dataset.name || '') + ' ' + alt + ' ' + (c.dataset.syn || '')).toLowerCase();
      }
      return c._hay;
    },
    matches(c) {
      if (this.plugin && c.dataset.plugin !== this.plugin) return false;
      const q = this.q.trim().toLowerCase();
      if (q && !this.haystack(c).includes(q)) return false;
      if (this.dup && !((+c.dataset.dup || 0) > 0)) return false;
      const { news, done } = this.badge(c);
      const ns = this.filterState;
      if (ns.new === 'show' && !news) return false;
      if (ns.new === 'hide' && news) return false;
      if (ns.done === 'show' && !done) return false;
      if (ns.done === 'hide' && done) return false;
      const f = +c.dataset.statusFlags || 0;
      if (ns.ongoing === 'show' && !(f & 4)) return false;
      if (ns.ongoing === 'hide' && (f & 4)) return false;
      if (ns.hiatus === 'show' && !(f & 8)) return false;
      if (ns.hiatus === 'hide' && (f & 8)) return false;
      if (ns.canceled === 'show' && !(f & 16)) return false;
      if (ns.canceled === 'hide' && (f & 16)) return false;
      if (ns.completed === 'show' && !(f & 32)) return false;
      if (ns.completed === 'hide' && (f & 32)) return false;
      if (ns.orphan === 'show' && c.dataset.state !== 'orphan') return false;
      if (ns.orphan === 'hide' && c.dataset.state === 'orphan') return false;
      return true;
    },
    dir(sortKey) { return (this.sortDir[sortKey] || 'asc') === 'desc' ? -1 : 1; },
    cmpFn() { // single ordering shared by the Pinned and Library sections
      const d = this.dir(this.sort);
      return (a, b) => {
        if (this.sort === 'title') return d * a.dataset.name.localeCompare(b.dataset.name) || (+b.dataset.added || 0) - (+a.dataset.added || 0);
        if (this.sort === 'progress') return d * (this.ratio(b) - this.ratio(a)) || (+b.dataset.added || 0) - (+a.dataset.added || 0);
        if (this.sort === 'read') return d * ((+b.dataset.lastread || 0) - (+a.dataset.lastread || 0)) || (+b.dataset.added || 0) - (+a.dataset.added || 0);
        if (this.sort === 'update') return d * ((+b.dataset.updated || 0) - (+a.dataset.updated || 0)) || (+b.dataset.added || 0) - (+a.dataset.added || 0);
        if (this.sort === 'dup') return d * ((+a.dataset.dup || 0) === 0 ? -1 : (+b.dataset.dup || 0) === 0 ? 1 : (+b.dataset.dup || 0) - (+a.dataset.dup || 0)) || a.dataset.name.localeCompare(b.dataset.name);
        return (+b.dataset.added || 0) - (+a.dataset.added || 0); // 'added'
      };
    },
    isPinned(c) { return c.dataset.pinned === '1' || c.dataset.pinned === 'true'; },
    apply() {
      const ul = document.getElementById('saved-cards');
      const pinUl = document.getElementById('pinned-cards');
      if (!ul) return;
      const cmp = this.cmpFn();
      const vis = this.cards.filter(c => this.matches(c)).sort(cmp);
      const pin = vis.filter(c => this.isPinned(c));
      const lib = vis.filter(c => !this.isPinned(c));
      const pinSet = new Set(pin), libSet = new Set(lib);
      this.pins = pin.length;
      this.count = vis.length;
      // library-pin: two sections — sorted append keeps cmp order in BOTH lists
      // (regressed to source order in the pin split); filtered-out cards hide in place
      for (const c of pin) { pinUl.appendChild(c); c.style.display = ''; } // pins render unpaged
      for (const c of lib) ul.appendChild(c); // display decided by the page slice below
      for (const c of this.cards) {
        if (pinSet.has(c) || libSet.has(c)) continue;
        if (pinUl && pinUl.contains(c)) { c.style.display = 'none'; }
        else { ul.appendChild(c); c.style.display = 'none'; }
      }
      const pages = Math.max(1, Math.ceil(lib.length / this.perPage));
      this.pages = pages;
      if (this.page > pages) this.page = pages;
      const start = (this.page - 1) * this.perPage, end = this.page * this.perPage;
      const shown = new Set(lib.slice(start, end));
      for (const c of lib) c.style.display = shown.has(c) ? '' : 'none';
      this.syncSidebar();
      this.save();
      this.sync(); // URL mirrors the visible state so any grid view can be shared
    },
  };
}
</script>
<div class="flex flex-wrap items-center gap-2 mb-3">
  <button x-show="hasDup" @click="toggleDup()" class="px-2.5 py-1 text-xs rounded-full border" :class="dup ? 'border-violet-500 bg-violet-900/40 text-violet-300' : 'border-zinc-700 text-zinc-400 hover:bg-zinc-800'">Duplicates</button>
  <button x-show="hasStats" @click="toggleBadge('new')" aria-label="Filter new" class="px-2.5 py-1 text-xs rounded-full border" :class="filterState.new === 'show' ? 'border-red-500 bg-red-900/40 text-red-300' : filterState.new === 'hide' ? 'border-red-700 bg-red-500/10 text-red-400/70' : 'border-zinc-700 text-zinc-400 hover:bg-zinc-800'" :title="filterState.new === 'show' ? 'show new' : filterState.new === 'hide' ? 'hide new' : 'new off'">New</button>
  <button x-show="hasStats" @click="toggleBadge('done')" aria-label="Filter done" class="px-2.5 py-1 text-xs rounded-full border" :class="filterState.done === 'show' ? 'border-emerald-500 bg-emerald-900/40 text-emerald-300' : filterState.done === 'hide' ? 'border-emerald-700 bg-emerald-500/10 text-emerald-400/70' : 'border-zinc-700 text-zinc-400 hover:bg-zinc-800'" :title="filterState.done === 'show' ? 'show done' : filterState.done === 'hide' ? 'hide done' : 'done off'">Done</button>
  <button @click="toggleBadge('ongoing')" aria-label="Filter ongoing" class="px-2.5 py-1 text-xs rounded-full border" :class="filterState.ongoing === 'show' ? 'border-sky-500 bg-sky-900/40 text-sky-300' : filterState.ongoing === 'hide' ? 'border-sky-700 bg-sky-500/10 text-sky-400/70' : 'border-zinc-700 text-zinc-400 hover:bg-zinc-800'" :title="filterState.ongoing === 'show' ? 'show ongoing' : filterState.ongoing === 'hide' ? 'hide ongoing' : 'ongoing off'">Ongoing</button>
  <button @click="toggleBadge('hiatus')" aria-label="Filter hiatus" class="px-2.5 py-1 text-xs rounded-full border" :class="filterState.hiatus === 'show' ? 'border-amber-500 bg-amber-900/40 text-amber-300' : filterState.hiatus === 'hide' ? 'border-amber-700 bg-amber-500/10 text-amber-400/70' : 'border-zinc-700 text-zinc-400 hover:bg-zinc-800'" :title="filterState.hiatus === 'show' ? 'show hiatus' : filterState.hiatus === 'hide' ? 'hide hiatus' : 'hiatus off'">Hiatus</button>
  <button @click="toggleBadge('canceled')" aria-label="Filter canceled" class="px-2.5 py-1 text-xs rounded-full border" :class="filterState.canceled === 'show' ? 'border-rose-500 bg-rose-900/40 text-rose-300' : filterState.canceled === 'hide' ? 'border-rose-700 bg-rose-500/10 text-rose-400/70' : 'border-zinc-700 text-zinc-400 hover:bg-zinc-800'" :title="filterState.canceled === 'show' ? 'show canceled' : filterState.canceled === 'hide' ? 'hide canceled' : 'canceled off'">Canceled</button>
  <button @click="toggleBadge('completed')" aria-label="Filter completed" class="px-2.5 py-1 text-xs rounded-full border" :class="filterState.completed === 'show' ? 'border-violet-500 bg-violet-900/40 text-violet-300' : filterState.completed === 'hide' ? 'border-violet-700 bg-violet-500/10 text-violet-400/70' : 'border-zinc-700 text-zinc-400 hover:bg-zinc-800'" :title="filterState.completed === 'show' ? 'show completed' : filterState.completed === 'hide' ? 'hide completed' : 'completed off'">Completed</button>
 <button x-show="hasOrphan()" @click="toggleBadge('orphan')" aria-label="Filter orphan" class="px-2.5 py-1 text-xs rounded-full border" :class="filterState.orphan === 'show' ? 'border-amber-500 bg-amber-900/40 text-amber-300' : filterState.orphan === 'hide' ? 'border-amber-700 bg-amber-500/10 text-amber-400/70' : 'border-zinc-700 text-zinc-400 hover:bg-zinc-800'">Orphan</button>
 <div class="flex items-center gap-1 text-xs border border-zinc-700 rounded px-1 py-0.5">
   <span class="text-zinc-500 px-1">Sort:</span>
   <button @click="setSort('added')" :class="scls('added')" class="px-1 py-0.5" :title="sort==='added' ? ('added ' + (sortDir.added || 'asc')) : 'sort added'">added<span x-text="sarrow('added')"></span></button>
   <button @click="setSort('title')" :class="scls('title')" class="px-1 py-0.5" :title="sort==='title' ? ('title ' + (sortDir.title || 'asc')) : 'sort title'">title<span x-text="sarrow('title')"></span></button>
   <button @click="setSort('progress')" :class="scls('progress')" class="px-1 py-0.5" :title="sort==='progress' ? ('progress ' + (sortDir.progress || 'asc')) : 'sort progress'">progress<span x-text="sarrow('progress')"></span></button>
   <button @click="setSort('read')" :class="scls('read')" class="px-1 py-0.5" :title="sort==='read' ? ('recent read ' + (sortDir.read || 'desc')) : 'sort recent read'">recent read<span x-text="sarrow('read')"></span></button>
   <button @click="setSort('update')" :class="scls('update')" class="px-1 py-0.5" :title="sort==='update' ? ('update ' + (sortDir.update || 'asc')) : 'sort update'">recent update<span x-text="sarrow('update')"></span></button>
   <button x-show="hasDup" @click="setSort('dup')" :class="scls('dup')" class="px-1 py-0.5" :title="sort==='dup' ? ('dup ' + (sortDir.dup || 'asc')) : 'sort dup'">dup<span x-text="sarrow('dup')"></span></button>
 </div>
  <button @click="reset()" class="px-2.5 py-1 text-xs rounded-full border border-zinc-700 text-zinc-400 hover:bg-zinc-800">Reset</button>
  <span class="text-xs text-zinc-500" x-text="count + ' / ' + total + ' shown'"></span>
</div>
<div x-show="count === 0 && total > 0" class="py-16 text-center text-zinc-500 text-sm">
  No manga matches
  <button @click="reset()" class="underline underline-offset-2 hover:text-zinc-300">Reset filters</button>
</div>
 <div x-show="pins > 0" x-cloak>
  <h2 class="text-sm font-semibold text-zinc-300 mb-2">Pinned</h2>
  <ul id="pinned-cards" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 mb-6"></ul>
 </div>
 <h2 class="text-sm font-semibold text-zinc-300 mb-2">Library</h2>
<ul id="saved-cards" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
  {{#saved_list}}
  <li data-name="{{name}}" data-plugin="{{plugin}}" data-status="{{status}}" data-total="{{total_ch}}" data-read="{{read_ch}}" data-status-flags="{{status_flags}}" data-added="{{added_at}}" data-lastread="{{last_read_at}}" data-updated="{{updated_at}}" data-dup="{{dup}}" data-pinned="{{pinned}}" data-syn="{{syn}}" data-alt="{{alt}}" data-state="{{state}}">
    <a href="{{url}}" class="group block min-w-0">
      <div class="relative">
        {{#cover}}
          <img src="/cache/img?url={{cover_q}}&cover=1&plugin={{plugin}}&slug={{slug}}"
               class="w-full aspect-[2/3] object-cover rounded-lg border border-zinc-800 transition duration-150 group-hover:border-zinc-700{{#dimmed}} cover-dim{{/dimmed}}" alt="{{name}}" loading="lazy"
               onerror="this.style.display='none';this.parentNode.querySelector('[data-fallback]').style.display='flex'">
        {{/cover}}
        <div class="aspect-[2/3] w-full rounded-lg flex items-center justify-center text-center text-2xl text-zinc-400 bg-zinc-800" data-fallback
             style="{{#cover}}display:none;{{/cover}}">{{name}}</div>
        <div class="absolute left-2 top-2 flex items-center gap-1">
          <span x-show="badge($el.closest('li')).news" class="rounded bg-red-600/70 px-2 py-0.5 text-[12px] font-semibold uppercase tracking-wide text-white">New</span>
          <span x-show="badge($el.closest('li')).done" class="rounded bg-emerald-600/70 px-2 py-0.5 text-[12px] font-semibold uppercase tracking-wide text-white">Done</span>
          <span x-show="$el.closest('li').dataset.state === 'orphan'" class="rounded bg-amber-600/70 px-2 py-0.5 text-[12px] font-semibold uppercase tracking-wide text-white" title="plugin not installed">Orphan</span>
          <span x-show="((+$el.closest('li').dataset.statusFlags || 0) & 4)" class="rounded bg-sky-900/60 border border-sky-700 px-2 py-0.5 text-[12px] font-medium uppercase tracking-wide text-sky-200">Ongoing</span>
          <span x-show="((+$el.closest('li').dataset.statusFlags || 0) & 8)" class="rounded bg-amber-900/60 border border-amber-700 px-2 py-0.5 text-[12px] font-medium uppercase tracking-wide text-amber-200">Hiatus</span>
          <span x-show="((+$el.closest('li').dataset.statusFlags || 0) & 16)" class="rounded bg-rose-900/60 border border-rose-700 px-2 py-0.5 text-[12px] font-medium uppercase tracking-wide text-rose-200">Canceled</span>
          <span x-show="((+$el.closest('li').dataset.statusFlags || 0) & 32)" class="rounded bg-violet-900/60 border border-violet-700 px-2 py-0.5 text-[12px] font-medium uppercase tracking-wide text-violet-200">Completed</span>
          <span x-show="!((+$el.closest('li').dataset.statusFlags || 0) & 60) && $el.closest('li').dataset.status" class="rounded bg-black/40 px-2 py-0.5 text-[12px] font-medium uppercase tracking-wide text-zinc-100" x-text="$el.closest('li').dataset.status"></span>
        </div>
        <button class="absolute left-2 bottom-2 rounded bg-black/40 px-2 py-0.5 text-[12px] text-zinc-100 hover:bg-black/60 flex items-center gap-1.5" @click.prevent="setPlugin('{{plugin}}')" aria-label="Filter by plugin {{plugin}}"><img src="/plugin/{{plugin}}/logo" alt="" class="w-5 h-5 rounded-sm" onerror="this.style.display='none'">{{plugin}}</button>
      </div>
      <p class="mt-1 text-sm truncate text-zinc-300 group-hover:text-zinc-100 transition-colors">{{name}}</p>
      <p class="text-xs text-zinc-500" x-show="(+$el.closest('li').dataset.total || 0) > 0"><span x-text="$el.closest('li').dataset.read"></span> / <span x-text="$el.closest('li').dataset.total"></span> read</p>
    </a>
  </li>
  {{/saved_list}}
</ul>
<div class="flex justify-end mt-4" x-show="count > 0 && pages > 1" x-cloak>
  <nav class="flex gap-1 items-center text-sm text-zinc-400">
    <button @click="page = Math.max(1, page - 1); apply()" :disabled="page <= 1" aria-label="Previous page" class="px-2 py-1 rounded bg-zinc-800 hover:bg-zinc-700 disabled:opacity-30">‹</button>
    <template x-for="n in Array.from({length: pages}, (_, i) => i + 1)" :key="n">
      <button @click="page = n; apply()" class="px-2 py-1 rounded" :class="n === page ? 'bg-zinc-700 text-zinc-100' : 'bg-zinc-800 hover:bg-zinc-700'" x-text="n"></button>
    </template>
    <button @click="page = Math.min(pages, page + 1); apply()" :disabled="page >= pages" aria-label="Next page" class="px-2 py-1 rounded bg-zinc-800 hover:bg-zinc-700 disabled:opacity-30">›</button>
  </nav>
</div>
</div>
{{/saved_mode}}
{{^saved_mode}}
<div class="py-16 text-center text-zinc-500 text-sm">No saved manga — open a detail page and click Add to library</div>
{{/saved_mode}}
