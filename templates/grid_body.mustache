<nav class="flex gap-3 text-sm">
  {{#has_prev}}<a href="/?plugin={{plugin}}&q={{q}}&page={{prev}}"
    hx-get="/library/grid?plugin={{plugin}}&q={{q}}&page={{prev}}" hx-target="#grid" hx-push-url="true">Prev</a>{{/has_prev}}
  <span class="text-zinc-400">{{page}} / {{pages}}</span>
  {{#has_next}}<a href="/?plugin={{plugin}}&q={{q}}&page={{next}}"
    hx-get="/library/grid?plugin={{plugin}}&q={{q}}&page={{next}}" hx-target="#grid" hx-push-url="true">Next</a>{{/has_next}}
</nav>
<ul class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
  {{#titles}}
  <li>
    <div class="aspect-[3/4] rounded" style="background:hsl({{hue}} 40% 28%)"></div>
    <p class="mt-1 text-sm truncate">{{name}}</p>
    <p class="text-xs text-zinc-500">{{plugin}}</p>
  </li>
  {{/titles}}
</ul>
<nav class="flex gap-3 text-sm">
  {{#has_prev}}<a href="/?plugin={{plugin}}&q={{q}}&page={{prev}}"
    hx-get="/library/grid?plugin={{plugin}}&q={{q}}&page={{prev}}" hx-target="#grid" hx-push-url="true">Prev</a>{{/has_prev}}
  <span class="text-zinc-400">{{page}} / {{pages}}</span>
  {{#has_next}}<a href="/?plugin={{plugin}}&q={{q}}&page={{next}}"
    hx-get="/library/grid?plugin={{plugin}}&q={{q}}&page={{next}}" hx-target="#grid" hx-push-url="true">Next</a>{{/has_next}}
</nav>
