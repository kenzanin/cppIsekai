<!-- top overlay: back + chapter dropdown (synced) + mode/dir/zoom. Shown only while navShown. -->
<div x-show="navShown && !done" x-cloak
     class="fixed top-0 inset-x-0 z-30 flex items-center justify-between gap-2 px-3 py-2 bg-zinc-950/95 border-b border-zinc-800 backdrop-blur">
  <!-- Left group: [view mode] [zoom] [ltr/rtl] -->
  <div class="flex items-center gap-2 shrink-0">
    <select x-model="mode" @change="modeChanged()" aria-label="Reading mode"
            class="bg-zinc-900 border border-zinc-700 rounded px-2.5 py-1.5 text-xs text-zinc-200 focus:outline-none focus:border-zinc-500">
      <option value="webtoon">webtoon</option>
      <option value="paged">paged</option>
      <option value="spread-h">spread h</option>
      <option value="spread-v">spread v</option>
    </select>
    <div class="flex items-center gap-1" role="group" aria-label="Image zoom">
      <button @click="zoomOut()" :disabled="zoom === 'custom' && zoomPct <= 25" aria-label="Zoom out"
              class="w-7 h-7 rounded border border-zinc-700 bg-zinc-900 text-sm leading-none text-zinc-100 hover:bg-zinc-800 disabled:opacity-30">&#8722;</button>
      <select x-model="zoom" @change="zoomPresetChanged()" aria-label="Zoom preset"
              class="bg-zinc-900 border border-zinc-700 rounded px-2 py-1.5 text-xs text-zinc-200 focus:outline-none focus:border-zinc-500">
        <option value="fit-w">fit W</option>
        <option value="fit-h">fit H</option>
        <option value="1:1">1:1</option>
        <option value="custom" x-text="zoom === 'custom' ? zoomPct + '%' : 'custom'"></option>
      </select>
      <button @click="zoomIn()" :disabled="zoom === 'custom' && zoomPct >= 400" aria-label="Zoom in"
              class="w-7 h-7 rounded border border-zinc-700 bg-zinc-900 text-sm leading-none text-zinc-100 hover:bg-zinc-800 disabled:opacity-30">+</button>
    </div>
    <select x-model="dir" x-show="mode !== 'webtoon'" @change="persist()" aria-label="Direction"
            class="bg-zinc-900 border border-zinc-700 rounded px-2.5 py-1.5 text-xs text-zinc-200 focus:outline-none focus:border-zinc-500">
      <option value="ltr">ltr</option>
      <option value="rtl">rtl</option>
    </select>
  </div>

  <!-- Right group: [chapter select with capped title] + page count -->
  <div class="flex items-center gap-2 min-w-0 max-w-[50vw] justify-end">
    <span class="text-xs text-zinc-400 tabular-nums shrink-0 hidden sm:inline" x-text="label()"></span>
    <select :value="ch" @change="gotoChapter($event.target.value)" aria-label="Chapter"
            class="bg-zinc-900 border border-zinc-700 rounded px-2.5 py-1.5 text-xs text-zinc-200 truncate max-w-full focus:outline-none focus:border-zinc-500">
      <template x-for="c in chaptersList" :key="c.id">
        <option :value="c.number" :selected="Number(c.number) === ch"
                x-text="formatChapterLabel(c)"></option>
      </template>
    </select>
    <!-- Exit to detail: extreme top-right corner -->
    <a :href="'/view/manga/'+encodeURIComponent(plugin)+'/'+encodeURIComponent(slug)"
       class="flex items-center gap-1.5 shrink-0 px-2.5 py-1.5 rounded border border-zinc-700 bg-zinc-900/80 text-zinc-100 hover:bg-zinc-800 transition-colors" aria-label="Back to detail">
      <span class="text-xs font-medium hidden sm:inline">Detail</span>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h4a2 2 0 012 2v12a2 2 0 01-2 2h-4"/><path d="M10 12H3.5"/><path d="M13.5 8L17.5 12 13.5 16"/></svg>
    </a>
  </div>
</div>
