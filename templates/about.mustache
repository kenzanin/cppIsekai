{{>top.mustache}}
<style>
  .about-md { max-width: 52rem; margin: 0 auto; line-height: 1.7; color: #d4d4d8; }
  .about-md h1 { font-size: 1.6rem; font-weight: 700; color: #fafafa; margin-bottom: .4rem; }
  .about-md h2 { font-size: 1.2rem; font-weight: 600; color: #fafafa; margin: 1.6rem 0 .5rem; border-bottom: 1px solid #27272a; padding-bottom: .3rem; }
  .about-md h3 { font-size: 1rem; font-weight: 600; color: #e4e4e7; margin: 1.1rem 0 .4rem; }
  .about-md p, .about-md li { margin: .45rem 0; }
  .about-md ul { list-style: disc; padding-left: 1.4rem; }
  .about-md ol { list-style: decimal; padding-left: 1.4rem; }
  .about-md a { color: #93c5fd; text-decoration: underline; text-underline-offset: 2px; }
  .about-md a:hover { color: #bfdbfe; }
  .about-md code { background: #18181b; border: 1px solid #27272a; border-radius: .3rem; padding: .1rem .35rem; font-size: .85em; }
  .about-md pre { background: #18181b; border: 1px solid #27272a; border-radius: .5rem; padding: .75rem 1rem; overflow-x: auto; margin: .6rem 0; }
  .about-md pre code { background: transparent; border: 0; padding: 0; }
  .about-md table { width: 100%; border-collapse: collapse; margin: .7rem 0; font-size: .9rem; }
  .about-md th, .about-md td { border: 1px solid #27272a; padding: .35rem .6rem; text-align: left; }
  .about-md th { background: #18181b; color: #e4e4e7; }
  .about-md svg { max-width: 100%; height: auto; }
  .about-md pre.mermaid, .about-md .mermaid { background: transparent; border: 0; text-align: center; }
  .mm-wrap { position: relative; }
  .mm-bar { position: absolute; top: .25rem; right: .25rem; display: flex; gap: .25rem; opacity: .25; transition: opacity .15s; z-index: 5; }
  .mm-wrap:hover .mm-bar, .mm-wrap:focus-within .mm-bar { opacity: 1; }
  .mm-bar button { background: #18181b; border: 1px solid #27272a; color: #d4d4d8; border-radius: .3rem; padding: 0 .4rem; font-size: .8rem; line-height: 1.4; cursor: pointer; }
  .mm-bar button:hover { border-color: #52525b; color: #fafafa; }
  .mm-wrap:fullscreen { background: #09090b; padding: 2rem; display: flex; flex-direction: column; }
  .mm-wrap:fullscreen pre { flex: 1; overflow: auto; margin: 0; }
</style>

<div id="about-content" class="about-md">
  <div class="text-zinc-500 text-sm py-10 text-center">Loading README&hellip;</div>
</div>

<script src="/static/marked.min.js"></script>
<script src="/static/mermaid.min.js"></script>
<script>
(function () {
  const GH = 'https://github.com/kenzanin/cppIsekai';
  const BRANCH = 'main';
  const el = document.getElementById('about-content');

  function fail(msg) {
    el.innerHTML = '<p class="text-red-400">Failed to render README.md: ' + msg +
      ' <button id="about-retry" class="underline ml-2">Retry</button></p>';
    document.getElementById('about-retry').addEventListener('click', () => location.reload());
  }

  // Per-diagram toolbar: zoom, fullscreen, SVG/PNG export. The svg keeps its
  // natural width; zoom scales it past the column and the <pre> scrolls.
  function decorateDiagrams() {
    const dl = (href, name) => {
      const a = document.createElement('a');
      a.href = href; a.download = name;
      document.body.appendChild(a); a.click(); a.remove();
    };
    document.querySelectorAll('.language-mermaid').forEach((pre, i) => {
      const svg = pre.querySelector('svg');
      if (!svg) return;
      const wrap = document.createElement('div');
      wrap.className = 'mm-wrap';
      pre.replaceWith(wrap); wrap.appendChild(pre);
      const bar = document.createElement('div');
      bar.className = 'mm-bar';
      bar.innerHTML =
        '<button title="Zoom in">+</button>' +
        '<button title="Zoom out">&minus;</button>' +
        '<button title="Reset zoom">100%</button>' +
        '<button title="Fullscreen">&#x26F6;</button>' +
        '<button title="Download SVG">SVG</button>' +
        '<button title="Download PNG">PNG</button>';
      wrap.appendChild(bar);
      const [zin, zout, zreset, fs, svgB, pngB] = bar.children;
      let scale = 1;
      const apply = () => {
        svg.style.maxWidth = 'none';
        svg.style.width = (scale * 100) + '%';
        svg.style.height = 'auto';
      };
      zin.onclick = () => { scale = Math.min(4, scale * 1.25); apply(); };
      zout.onclick = () => { scale = Math.max(.5, scale / 1.25); apply(); };
      zreset.onclick = () => { scale = 1; svg.style.maxWidth = ''; svg.style.width = ''; svg.style.height = ''; };
      fs.onclick = () => (document.fullscreenElement ? document.exitFullscreen() : wrap.requestFullscreen());
      const src = new XMLSerializer().serializeToString(svg);
      svgB.onclick = () => dl(URL.createObjectURL(new Blob([src], { type: 'image/svg+xml' })), 'diagram-' + (i + 1) + '.svg');
      pngB.onclick = () => {
        try {
          const img = new Image();
          img.onload = () => {
            const vb = svg.viewBox && svg.viewBox.baseVal;
            const w = (vb && vb.width) || img.naturalWidth, h = (vb && vb.height) || img.naturalHeight;
            const c = document.createElement('canvas'); c.width = w * 2; c.height = h * 2;
            c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
            c.toBlob(b => b && dl(URL.createObjectURL(b), 'diagram-' + (i + 1) + '.png'), 'image/png');
          };
          img.onerror = () => {};
          img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(src);
        } catch (err) { console.warn('png export failed', err); }
      };
    });
  }

  fetch('/about/readme', { cache: 'no-cache' })
    .then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
    .then(md => {
      el.innerHTML = marked.parse(md);

      // Repo-root relative links (e.g. `ARCHITECTURE.md`) live on GitHub, not in the app.
      el.querySelectorAll('a[href]').forEach(a => {
        const href = a.getAttribute('href') || '';
        if (/^(https?:|mailto:|#)/.test(href)) {
          if (/^https?:/.test(href)) { a.target = '_blank'; a.rel = 'noopener'; }
          return;
        }
        a.href = GH + '/blob/' + BRANCH + '/' + href.replace(/^\.\//, '');
        a.target = '_blank';
        a.rel = 'noopener';
      });

      mermaid.initialize({ startOnLoad: false, theme: 'dark', securityLevel: 'strict' });
      mermaid.run({ querySelector: '.language-mermaid' }).then(decorateDiagrams).catch(e => {
        const warn = document.createElement('p');
        warn.className = 'text-yellow-500 text-sm';
        warn.textContent = 'Diagrams failed to render: ' + (e.message || e);
        el.prepend(warn);
      });
    })
    .catch(e => fail(e.message || String(e)));
})();
</script>
{{>bottom.mustache}}
