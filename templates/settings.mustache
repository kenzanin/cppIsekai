{{>top.mustache}}
<div x-data="settingsPage" x-init="boot()">
  <h1 class="text-lg font-semibold mb-3">Settings</h1>
  <p class="text-xs text-zinc-500 mb-3">Values resolve per layer: default &lt; ini &lt; <code>CPPISEKAI_*</code> env &lt; <code>--flag</code>. Rows won by env/flag are read-only. Save writes the ini in place; comments survive.</p>
  <p class="text-sm text-red-400 mb-2" x-show="err" x-text="err" x-cloak></p>
  <p class="text-sm text-zinc-500 mb-2" x-show="note" x-text="note" x-cloak></p>

  <div x-show="loading" class="text-sm text-zinc-500">…</div>

  <template x-for="section in sections()" :key="section">
    <section class="mb-5">
      <h2 class="text-xs uppercase tracking-wide text-zinc-500 mb-2" x-text="section"></h2>
      <ul class="space-y-2">
        <template x-for="k in knobs.filter(x => x.section === section)" :key="k.fullKey">
          <li class="border border-zinc-800 rounded p-3">
            <div class="flex items-center gap-2 flex-wrap">
              <code class="text-xs text-zinc-400" x-text="k.fullKey"></code>
              <span class="text-[10px] uppercase rounded px-1.5 py-0.5 bg-zinc-800 text-zinc-400" x-text="sourceOf(k)"></span>
              <span class="text-[10px] rounded px-1.5 py-0.5 bg-amber-900/40 text-amber-400" x-show="k.restart">restart to apply</span>
              <span class="text-[10px] rounded px-1.5 py-0.5 bg-emerald-900/40 text-emerald-400" x-show="k.live">applied live</span>
              <span class="flex-1"></span>
              <!-- input -->
              <template x-if="enumOf(k)">
                <select class="bg-zinc-900 border border-zinc-700 rounded px-2 py-1.5 text-sm"
                        :value="k.value" :disabled="readOnly(k)"
                        @change="dirty[k.fullKey] = $event.target.value">
                  <template x-for="opt in enumOf(k)" :key="opt">
                    <option :value="opt" :selected="opt === k.value" x-text="opt"></option>
                  </template>
                </select>
              </template>
              <template x-if="!enumOf(k) && k.type !== 'str'">
                <input type="number" min="1" step="256" class="bg-zinc-900 border border-zinc-700 rounded px-2 py-1.5 text-sm w-48"
                       :value="k.value" :disabled="readOnly(k)"
                       @input="dirty[k.fullKey] = $event.target.value">
              </template>
              <template x-if="!enumOf(k) && k.type === 'str'">
                <span class="flex items-center gap-2">
                  <template x-if="k.fullKey === 'server.proxy' && !reveal[k.fullKey]">
                    <input type="password" class="bg-zinc-900 border border-zinc-700 rounded px-2 py-1.5 text-sm w-80"
                           :value="k.value" :disabled="readOnly(k)"
                           @input="dirty[k.fullKey] = $event.target.value">
                  </template>
                  <template x-if="!(k.fullKey === 'server.proxy' && !reveal[k.fullKey])">
                    <input type="text" class="bg-zinc-900 border border-zinc-700 rounded px-2 py-1.5 text-sm w-80"
                           :value="k.value" :disabled="readOnly(k)"
                           @input="dirty[k.fullKey] = $event.target.value">
                  </template>
                  <button type="button" x-show="k.fullKey === 'server.proxy'" class="text-xs text-zinc-500 underline"
                          @click="reveal[k.fullKey] = !reveal[k.fullKey]" x-text="reveal[k.fullKey] ? 'hide' : 'show'"></button>
                </span>
              </template>
            </div>
            <p class="text-xs text-zinc-500 mt-1" x-text="k.doc"></p>
            <p class="text-xs text-amber-500/80 mt-1" x-show="readOnly(k)"
               x-text="'won by ' + sourceOf(k) + ' — editing the ini will not change this value'"></p>
          </li>
        </template>
      </ul>
    </section>
  </template>

  <div class="flex gap-2 mt-4 items-center">
    <button @click="save()" :disabled="saving || Object.keys(dirty).length === 0"
            class="px-4 py-1.5 text-sm rounded bg-zinc-100 text-zinc-900 disabled:opacity-40">Save changes</button>
    <button @click="dirty = {}" class="px-4 py-1.5 text-sm rounded bg-zinc-800 hover:bg-zinc-700">Discard edits</button>
    <span class="flex-1"></span>
    <button @click="restart()" :disabled="restarting"
            class="px-4 py-1.5 text-sm rounded bg-red-900/70 hover:bg-red-800 text-red-100 disabled:opacity-40"
            x-text="restarting ? 'Restarting…' : 'Restart server'"></button>
  </div>
</div>
{{>settings_script.mustache}}
{{>bottom.mustache}}
