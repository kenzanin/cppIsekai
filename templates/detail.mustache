{{>top.mustache}}
<div x-data="detailPage" x-init="boot()">
  <!-- header: cover + meta -->
  <div class="flex gap-5 mb-6">
    <div class="relative shrink-0">
      <template x-if="detail.cover">
        <img :src="'/cache/img?url='+encodeURIComponent(detail.cover)+'&cover=1&plugin='+encodeURIComponent(plugin)+'&slug='+encodeURIComponent(slug)" class="w-40 h-56 object-cover rounded-lg" @error="coverBroken=true" x-show="!coverBroken" alt="">
      </template>
      <button @click="resetCover()" :disabled="enrichBusy" x-show="inLibrary && enrichment && enrichment.chosen && enrichment.chosen.cover" x-cloak class="absolute bottom-1 right-1 text-[10px] px-1.5 py-0.5 rounded bg-black/70 text-zinc-300 hover:text-white" title="drop chosen cover, restore the library cover">Reset cover</button>
    </div>
    <div class="flex-1 min-w-0">
      <h1 class="text-2xl font-semibold mb-2 leading-tight" x-text="detail.name || '…'"></h1>
      <div class="flex flex-wrap gap-1.5 mb-2" x-show="detail.status || detail.release_at" x-cloak>
        <span class="text-xs px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-300" x-show="detail.status" x-text="detail.status"></span>
        <span class="text-xs px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-400" x-show="detail.release_at" x-text="fmtDate(detail.release_at)"></span>
        <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-900/40 text-emerald-300 border border-emerald-800" x-show="cached">cached</span>
      </div>
      <div class="flex flex-wrap gap-1.5 mb-3" x-show="detail.tags && detail.tags.length" x-cloak>
        <template x-for="t in detail.tags" :key="t">
          <span class="text-xs px-2 py-0.5 rounded-full border border-zinc-700 text-zinc-400" x-text="t"></span>
        </template>
      </div>
      <div class="text-sm text-zinc-400 mb-1" x-show="detail.authors && detail.authors.length" x-cloak>
        <span class="text-zinc-500">Author:</span> <span x-text="(detail.authors || []).join(', ')"></span>
      </div>
      <div class="text-sm text-zinc-400 mb-1" x-show="detail.artists && detail.artists.length" x-cloak>
        <span class="text-zinc-500">Artist:</span> <span x-text="(detail.artists || []).join(', ')"></span>
      </div>
      <p class="text-sm text-zinc-400 leading-relaxed" x-show="detail.description" x-text="detail.description"></p>
      <div class="flex gap-2 mt-4">
        <template x-if="hint">
        <a :href="hint.url"
           class="px-3 py-1.5 text-sm border border-emerald-700 bg-emerald-900/40 text-emerald-300 hover:bg-emerald-900/60 rounded-md"
           x-text="hint.text"></a>
      </template>
        <button @click="toggleLibrary()"
                class="px-3 py-1.5 text-sm border rounded-md disabled:opacity-40"
                :class="inLibrary ? 'border-emerald-700 bg-emerald-900/40 text-emerald-300 hover:bg-emerald-900/60' : 'border-zinc-700 text-zinc-300 hover:bg-zinc-800'"
                x-text="inLibrary ? 'In library' : 'Add to library'"></button>
        <button @click="refresh()" :disabled="refreshing"
                class="px-3 py-1.5 text-sm border border-zinc-700 text-zinc-300 hover:bg-zinc-800 rounded-md disabled:opacity-40"
                x-text="refreshing ? '…' : '⟳ Update'"></button>
      </div>
      <p class="text-xs text-red-400 mt-2" x-show="err" x-text="err" x-cloak></p>
      <!-- enrichment (detail-enrichment-fields): fetch detail/covers, picker, reset. Saved-manga library gate is enforced server-side (not in library = 404). -->
      <div class="mt-4 flex flex-wrap items-center gap-2" x-show="inLibrary" x-cloak>
        <button @click="openEnrich('detail', false)" :disabled="enrichBusy" class="px-3 py-1.5 text-xs border border-zinc-700 rounded-md text-zinc-300 hover:bg-zinc-800 disabled:opacity-40">Fetch detail</button>
        <button @click="openEnrich('detail', true)" :disabled="enrichBusy" class="px-3 py-1.5 text-xs border border-zinc-800 rounded-md text-zinc-500 hover:bg-zinc-800 disabled:opacity-40" title="always refetch, overwrite stored candidates">⟳ force</button>
        <button @click="openEnrich('covers', false)" :disabled="enrichBusy" class="px-3 py-1.5 text-xs border border-zinc-700 rounded-md text-zinc-300 hover:bg-zinc-800 disabled:opacity-40">Fetch covers</button>
        <button @click="openEnrich('covers', true)" :disabled="enrichBusy" class="px-3 py-1.5 text-xs border border-zinc-800 rounded-md text-zinc-500 hover:bg-zinc-800 disabled:opacity-40" title="always refetch candidate covers">⟳ force</button>
        <button @click="resetDetail()" :disabled="enrichBusy" class="px-3 py-1.5 text-xs border border-zinc-800 rounded-md text-zinc-500 hover:bg-zinc-800 disabled:opacity-40" title="clear chosen title/synopsis/artist/author/tags (keeps cover)">Reset detail</button>
        <span class="text-[11px] text-zinc-600" x-show="enrichLastFetched" x-text="'last fetched ' + fmtEnrichDate(enrichLastFetched)"></span>
        <span class="text-[11px] text-zinc-600" x-show="enrichBusy">fetching…</span>
      </div>
      <!-- picker panel: candidates grouped per source, user picks; nothing auto-applied -->
      <div :class="enrichKind === 'covers' ? 'fixed inset-0 z-50 bg-black/80 backdrop-blur-sm overflow-y-auto p-6' : 'mt-3 border border-zinc-800 rounded-lg p-3 text-sm'" x-show="enrichOpen" x-cloak @keydown.escape.window="enrichOpen = false">
        <div :class="enrichKind === 'covers' ? 'max-w-4xl mx-auto bg-zinc-950 border border-zinc-800 rounded-xl p-4 text-sm' : ''">
        <div class="flex items-center gap-2 mb-2">
          <strong class="text-zinc-300" x-text="enrichKind === 'covers' ? 'Cover candidates' : 'Detail candidates'"></strong>
          <button class="text-xs text-zinc-500 underline" @click="enrichOpen = false">close</button>
          <span class="flex-1"></span>
          <span class="text-xs text-red-400" x-show="enrichErr" x-text="enrichErr"></span>
        </div>
        <p class="text-xs text-zinc-600 mb-2">Pick per field; nothing is applied until you choose it. Tags can be toggled; the detail page hides any tag in “hidden tags”.</p>
        <template x-for="src in enrichSources" :key="src.id">
          <div class="mb-3" x-show="candFor(src.id, enrichKind)">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs uppercase tracking-wide text-zinc-500" x-text="src.name || src.id"></span>
              <span class="text-[10px] text-zinc-700" x-show="busySources[src.id]">fetching…</span>
              <span class="text-[10px] text-zinc-700" x-show="!busySources[src.id] && candFor(src.id, enrichKind) && candFor(src.id, enrichKind).cached">(cached)</span>
            </div>
            <template x-if="candFor(src.id, enrichKind) && candFor(src.id, enrichKind).ok">
              <div>
                <template x-if="enrichKind === 'covers'">
                  <div class="flex flex-wrap gap-2">
                    <template x-for="u in (candFor(src.id, 'covers').data && candFor(src.id, 'covers').data.covers) || []" :key="u">
                      <button @click="pickField('cover', u)" class="w-20 border rounded overflow-hidden hover:ring-2 hover:ring-emerald-600" :class="chosenNow().cover === u ? 'ring-2 ring-emerald-600' : ''">
                        <img :src="'/cache/img?url='+encodeURIComponent(u)+'&cover=1&plugin='+encodeURIComponent(plugin)+'&slug='+encodeURIComponent(slug)" class="w-full aspect-[2/3] object-cover" loading="lazy" alt="">
                      </button>
                    </template>
                  </div>
                </template>
                <template x-if="enrichKind !== 'covers'">
                  <div class="space-y-1">
                    <p x-show="candFor(src.id, 'detail').data && candFor(src.id, 'detail').data.title" class="flex items-center gap-2">
                      <button @click="pickField('title', candFor(src.id, 'detail').data.title)" class="text-xs px-2 py-0.5 rounded border border-zinc-700 text-zinc-400 hover:bg-zinc-800">use title</button>
                      <span class="text-xs text-zinc-300" x-text="candFor(src.id, 'detail').data.title"></span>
                    </p>
                    <p x-show="candFor(src.id, 'detail').data && candFor(src.id, 'detail').data.synopsis" class="leading-snug">
                      <button @click="pickField('synopsis', candFor(src.id, 'detail').data.synopsis)" class="text-xs px-2 py-0.5 rounded border border-zinc-700 text-zinc-400 hover:bg-zinc-800 mr-1">use synopsis</button>
                      <span class="text-xs text-zinc-500" x-text="candFor(src.id, 'detail').data.synopsis"></span>
                    </p>
                    <p x-show="candFor(src.id, 'detail').data && (candFor(src.id, 'detail').data.authors || []).length" class="flex items-center gap-1 flex-wrap">
                      <span class="text-[10px] text-zinc-600 mr-1">authors</span>
                      <template x-for="a in candFor(src.id, 'detail').data.authors" :key="a">
                        <button @click="toggleName('author', a)" class="text-xs px-2 py-0.5 rounded-full border" :class="(chosenNow().author || []).includes(a) ? 'border-emerald-600 text-emerald-300' : 'border-zinc-700 text-zinc-500 hover:text-zinc-300'" x-text="a"></button>
                      </template>
                    </p>
                    <p x-show="candFor(src.id, 'detail').data && (candFor(src.id, 'detail').data.artists || []).length" class="flex items-center gap-1 flex-wrap">
                      <span class="text-[10px] text-zinc-600 mr-1">artists</span>
                      <template x-for="a in candFor(src.id, 'detail').data.artists" :key="a">
                        <button @click="toggleName('artist', a)" class="text-xs px-2 py-0.5 rounded-full border" :class="(chosenNow().artist || []).includes(a) ? 'border-emerald-600 text-emerald-300' : 'border-zinc-700 text-zinc-500 hover:text-zinc-300'" x-text="a"></button>
                      </template>
                    </p>
                    <p x-show="candFor(src.id, 'detail').data && (candFor(src.id, 'detail').data.tags || []).length" class="flex items-center gap-1 flex-wrap">
                      <span class="text-[10px] text-zinc-600 mr-1">tags</span>
                      <template x-for="t in candFor(src.id, 'detail').data.tags" :key="t">
                        <button @click="toggleTag(t)" class="text-xs px-2 py-0.5 rounded-full border" :class="(chosenNow().tags_add || []).includes(t) ? 'border-emerald-600 text-emerald-300' : 'border-zinc-700 text-zinc-500 hover:text-zinc-300'" x-text="t"></button>
                      </template>
                    </p>
                  </div>
                </template>
              </div>
            </template>
            <p class="text-xs text-red-400" x-show="candFor(src.id, enrichKind) && !candFor(src.id, enrichKind).ok" x-text="(candFor(src.id, enrichKind) || {}).error"></p>
          </div>
        </template>
        <p class="text-xs text-zinc-600" x-show="!enrichSources.length">No enrichment sources loaded. Dev copies: symlink <code>~/tmp/goIsekai</code>… → see README “Enrichment plugins”.</p>
        </div>
      </div>

  <!-- chapters (chapter-list-controls 2.1): eye/check toggles, read/total counter,
       client-side pager 20/page -->
  <h2 class="text-xl font-semibold mb-4 flex items-center justify-between">
    <span>Chapters</span>
    <span class="flex items-center gap-2 text-sm font-normal" x-show="pageCount > 1" x-cloak>
      <button class="px-2 border border-zinc-700 rounded disabled:opacity-30" :disabled="chPage <= 0"
              @click="chPage--">‹</button>
      <span class="text-xs text-zinc-500" x-text="(chPage+1)+' / '+pageCount"></span>
      <button class="px-2 border border-zinc-700 rounded disabled:opacity-30" :disabled="chPage >= pageCount-1"
              @click="chPage++">›</button><button x-show="hiddenCount() > 0" @click="showHidden = !showHidden" class="px-1.5 border border-zinc-700 rounded text-xs" :class="showHidden ? 'text-emerald-400 border-emerald-700' : ''" x-cloak x-text="(showHidden ? 'hide' : 'show') + ' ' + hiddenCount()" title="toggle hidden chapters"></button>
    </span>
  </h2>
  <p class="text-sm text-zinc-500 mb-3" x-show="!loading && !chapters.length && !err" x-cloak>No chapters.</p>
  <div class="divide-y divide-zinc-800 border border-zinc-800 rounded-lg" x-show="chapters.length" x-cloak>
    <template x-for="ch in chPageRows()" :key="ch.id">
      <div class="flex items-center gap-3 px-4 py-2.5 hover:bg-zinc-900/50">
        <!-- eye: hide/show chapter row (skip flag feeds reader window) -->
        <button @click="toggleDone(ch)" class="shrink-0" :class="ch.done ? 'text-emerald-400' : 'text-zinc-600 hover:text-zinc-400'"
                :title="ch.done ? 'unhide chapter' : 'hide chapter'">
          <svg x-show="!ch.done" class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 3C5 3 1.7 7 1 10c.7 3 4 7 9 7s8.3-4 9-7c-.7-3-4-7-9-7Zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-2a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg>
          <svg x-show="ch.done" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 20 20"><path d="M2 10c.7-3 4-7 8-7s7.3 4 8 7c-.7 3-4 7-8 7s-7.3-4-8-7Zm8 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke-linecap="round"/><path d="M3 17 17 3" stroke-linecap="round"/></svg>
        </button>
        <a :href="'/read/'+encodeURIComponent(plugin)+'/'+encodeURIComponent(slug)+'?ch='+(Number(ch.number) || ch.number)"
           class="text-sm font-medium w-20 shrink-0 hover:text-emerald-300" x-text="chLabel(ch)"></a>
        <span class="text-xs text-zinc-500 flex-1 truncate" x-text="ch.title"></span>
        <span class="text-xs text-zinc-500" x-text="fmtDate(ch.release_at)"></span>
        <!-- read/total counter; total when the plugin reports it -->
        <span class="text-xs text-zinc-500 tabular-nums" x-show="readMax(ch) > 0" x-text="readMax(ch)+(ch.pages ? '/'+ch.pages : '')"></span>
        <!-- check: read state, lit when fully read -->
        <button @click="toggleRead(ch)" class="shrink-0" :class="isRead(ch) ? 'text-emerald-400' : 'text-zinc-600 hover:text-zinc-400'"
                :title="isRead(ch) ? 'unread' : 'mark read'">
          <svg x-show="isRead(ch)" class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 1 2.5 3.5v5c0 4.5 3.2 8.7 7.5 10 4.3-1.3 7.5-5.5 7.5-10v-5L10 1Zm-1 12-3-3 1.4-1.4L9 10.2l4.6-4.6L15 7l-6 6Z"/></svg>
          <svg x-show="!isRead(ch)" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 20 20"><path d="M10 2 3.5 4.2v4.3c0 4 2.9 7.8 6.5 9 3.6-1.2 6.5-5 6.5-9V4.2L10 2Z" stroke-linejoin="round"/><path d="m7 10 2.2 2.2L13.5 8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <a x-show="cbzReady[ch.id]" :href="'/export/cbz?plugin='+plugin+'&slug='+encodeURIComponent(slug+'/'+chSlug(ch))"
           class="text-xs h-7 px-2 inline-flex items-center rounded border border-zinc-700 text-zinc-300 hover:bg-zinc-800" title="export cached chapter as cbz">⬇ cbz</a>
        <span x-show="!cbzReady[ch.id]" class="text-xs h-7 px-2 inline-flex items-center rounded border border-zinc-800 text-zinc-600 cursor-not-allowed" title="chapter not fully cached yet">⬇ cbz</span>
      </div>
    </template>
  </div>
  <!-- related (user steer): text-only links to the source site; hidden until data arrives -->
  <div class="mt-8" x-show="related.length" x-cloak>
    <h2 class="text-xl font-semibold mb-4">Related</h2>
    <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1">
      <template x-for="m in related" :key="m.id">
        <li class="text-sm truncate">
          <a :href="m.url" target="_blank" rel="noopener" class="text-zinc-300 hover:text-emerald-300 hover:underline" x-text="m.name"></a>
        </li>
      </template>
    </ul>
  </div>

  <!-- attribution (detail-enrichment 3.1): plugin name + logo; @error falls back to name only -->
  <div class="mt-6 flex items-center gap-2 text-xs text-zinc-500" x-show="pluginName" x-cloak>
    <template x-if="pluginLogoOk">
      <img :src="'/plugin/'+encodeURIComponent(plugin)+'/logo'" class="h-5 w-5 object-contain rounded" @error="pluginLogoOk=false" alt="">
    </template>
    <span x-text="pluginName"></span>
  </div>
</div>

{{>detail_script.mustache}}
{{>bottom.mustache}}
