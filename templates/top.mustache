<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>cppIsekai</title>
  <script src="/static/tailwind.min.js"></script>
  <script src="/static/htmx.min.js"></script>
  <script defer src="/static/alpine.min.js"></script>
  <style>
    /* dim+blur for cover images only (covers carry &cover=1); server-rendered from host/dim_blur */
    .dim-blur img[src*="cover=1"] { filter: brightness(0.35) blur(6px); }
    .dim-toggle { font-size: 11px; }
  </style>
  <script>
    const paintToggles = function (on) { document.querySelectorAll('[data-dim-toggle]').forEach(b => b.textContent = on ? 'Show covers' : 'Dim + blur covers'); };
    window.toggleDimBlur = async function () {
      const on = !document.body.classList.contains('dim-blur');
      try {
        const r = await fetch('/api/display/dim-blur', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ on }) });
        if (!r.ok) return;
        document.body.classList.toggle('dim-blur', on);
        paintToggles(on);
      } catch (e) { /* server unreachable; leave UI unchanged */ }
    };
    document.addEventListener('DOMContentLoaded', function () { paintToggles(document.body.classList.contains('dim-blur')); });
  </script>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen{{#dim_blur}} dim-blur{{/dim_blur}}">
  <header class="flex items-center gap-1 border-b border-zinc-800 px-4 h-12">
    <a href="/" class="px-3 py-1 rounded hover:bg-zinc-800/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500 transition-colors {{#active_library}}bg-zinc-800{{/active_library}}">Library</a>
    <a href="/search" class="px-3 py-1 rounded hover:bg-zinc-800/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500 transition-colors {{#active_search}}bg-zinc-800{{/active_search}}">Search</a>
    <a href="/plugins" class="px-3 py-1 rounded hover:bg-zinc-800/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500 transition-colors {{#active_plugins}}bg-zinc-800{{/active_plugins}}">Plugins</a>
    <a href="/settings" class="px-3 py-1 rounded hover:bg-zinc-800/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500 transition-colors {{#active_settings}}bg-zinc-800{{/active_settings}}">Settings</a>
    <span class="flex-1"></span>
    <a href="/logs" class="px-3 py-1 rounded hover:bg-zinc-800/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500 transition-colors {{#active_logs}}bg-zinc-800{{/active_logs}}">Logs</a>
    <a href="/about" class="px-3 py-1 rounded hover:bg-zinc-800/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500 transition-colors {{#active_about}}bg-zinc-800{{/active_about}}">About</a>
  </header>
