<div id="toast-host" class="fixed bottom-4 right-4 z-50 flex flex-col items-end gap-2"></div>
<script>
(function () {
  const host = document.getElementById('toast-host');
  const KINDS = {
    success: 'bg-emerald-600 text-white',
    error: 'bg-red-600 text-white',
    info: 'bg-zinc-700 text-zinc-100'
  };
  window.toast = function (kind, msg) {
    if (document.activeElement && document.activeElement.tagName === 'BUTTON') led(document.activeElement, kind === 'success' ? 'bg-emerald-400' : kind === 'error' ? 'bg-red-400' : 'bg-amber-400', 3000);
    while (host.children.length >= 4) host.firstElementChild.remove();
    const t = document.createElement('div');
    t.className = 'px-3 py-2 rounded shadow-lg text-sm cursor-pointer max-w-xs ' + (KINDS[kind] || KINDS.info);
    t.textContent = msg;
    t.onclick = function () { t.remove(); };
    host.appendChild(t);
    setTimeout(function () { t.remove(); }, kind === 'error' ? 8000 : 5000);
    return t;
  };
  const ledClass = function (btn, color) {
    // Icon-only controls stay square: park the LED on the corner instead of
    // widening the button with an inline dot.
    return 'feedback-led w-2 h-2 rounded-full ' + color + ' ' +
      (btn.classList.contains('icon-action') ? 'absolute -top-1 -right-1 ml-0' : 'inline-block ml-2 align-middle');
  };
  const led = function (btn, color, ms) {
    if (!btn) return;
    let d = btn.querySelector(':scope > .feedback-led');
    if (!d) {
      d = document.createElement('span');
      d.className = ledClass(btn, color);
      btn.appendChild(d);
    }
    d.className = ledClass(btn, color);
    if (ms > 0) {
      clearTimeout(d._t);
      d._t = setTimeout(function () { d.remove(); }, ms);
    }
  };
  window.runFeedback = async function (job, btn) {
    if (btn) { btn.disabled = true; btn.classList.add('opacity-60'); }
    led(btn, 'bg-amber-400'); // persistent until job resolves
    let r = null;
    try {
      r = await job();
    } catch (e) {
      window.toast('error', (e && e.message) || String(e));
      led(btn, 'bg-red-400', 3000);
      if (btn) { btn.disabled = false; btn.classList.remove('opacity-60'); }
      return;
    }
    const ok = !!(r && r.ok);
    window.toast(ok ? 'success' : 'error', ok ? ((r && r.message) || 'Done') : ((r && r.error) || 'Failed'));
    led(btn, ok ? 'bg-emerald-400' : 'bg-red-400', 3000);
    if (btn) { btn.disabled = false; btn.classList.remove('opacity-60'); }
  };
})();
</script>
