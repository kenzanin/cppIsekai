<script>
function pluginsPage() {
  return {
    plugins: [], enrich: [], q: new URLSearchParams(location.search).get('q') || '', busy: false,
    broken: {},
    init() { this.$watch('q', () => { // shareable filter: ?q=…
      const u = new URL(location); u.search = '';
      if (this.q) u.searchParams.set('q', this.q);
      history.replaceState({}, '', u);
    }); },
    async load() {
      this.busy = true
      const j = await (await fetch('/api/plugins')).json()
      this.plugins = j.plugins || []
      this.enrich = j.enrichment || []
      this.busy = false
    },
    get view() {
      const q = this.q.trim().toLowerCase()
      if (!q) return this.plugins
      return this.plugins.filter(r =>
        r.name.toLowerCase().includes(q) || (r.caps || '').toLowerCase().includes(q))
    },
    get enrichView() {
      const q = this.q.trim().toLowerCase()
      if (!q) return this.enrich
      return this.enrich.filter(e =>
        e.name.toLowerCase().includes(q) || (e.caps || '').toLowerCase().includes(q))
    },
    caps(r) { return (r.caps || '').split(',').filter(Boolean) },
    stateText(r) { return !r.enabled ? '○ disabled' : (r.state === 'error' ? '⚠ error' : '● active') },
    stateClass(r) {
      if (!r.enabled) return 'text-zinc-500'
      return r.state === 'error' ? 'text-yellow-400' : 'text-green-400'
    },
    async toggle(r) {
      try {
        const res = await fetch('/plugin/' + r.id + '/enabled', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ enabled: !r.enabled })
        })
        const j = await res.json().catch(() => ({}))
        if (!res.ok) window.toast('error', j.error || 'HTTP ' + res.status)
        else window.toast('success', (j.enabled ? 'Enabled ' : 'Disabled ') + r.name)
      } catch (e) { window.toast('error', String(e)) }
      await this.load()
    },
    async reload() {
      this.busy = true
      try {
        const res = await fetch('/plugins/reload', { method: 'POST' })
        const j = await res.json().catch(() => ({}))
        if (!res.ok) window.toast('error', j.error || 'HTTP ' + res.status)
        else window.toast('success', 'Reloaded ' + (j.count ?? '?') + ' plugin(s)')
      } catch (e) { window.toast('error', String(e)) }
      await this.load()
    },
    async clearCache(r) { // drop cached envelopes; next plugin call refetches
      try {
        const res = await fetch('/plugins/cache-clear', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ plugin: r.key })
        })
        const j = await res.json().catch(() => ({}))
        if (!res.ok || j.ok === false) window.toast('error', j.error || 'HTTP ' + res.status)
        else window.toast('success', 'Cleared ' + (j.cleared ?? '?') + ' for ' + r.name)
      } catch (e) { window.toast('error', String(e)) }
    },
  }
}
</script>
